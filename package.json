{
  "name": "hugo-leyline",
  "private": true,
  "description": "Build helpers for the Leyline Hugo theme. Sites consuming the theme should mirror the `build` script (or its two steps) so Pagefind search can index the rendered HTML.",
  "scripts": {
    "serve": "cd exampleSite && hugo server --themesDir=../..",
    "build": "cd exampleSite && hugo --gc --minify --themesDir=../.. && pagefind --site public",
    "prepare:scryfall": "python3 ../hugo-mtg-shortcodes/scripts/prepare-scryfall.py --output exampleSite/data/scryfall.json",
    "prebuild": "npm run prepare:scryfall",
    "preserve": "npm run prepare:scryfall"
  },
  "devDependencies": {
    "pagefind": "^1.4.0"
  }
}
